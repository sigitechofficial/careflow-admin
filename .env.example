# CareAdmin frontend — local development
#
# Recommended: use the Vite dev proxy (see vite.config.ts) so API calls are
# same-origin and skip CORS preflights entirely.
#
#   VITE_API_BASE_URL=/api
#
# The proxy forwards /api/* → http://localhost:3000/* (backend must be running).
#
# Alternative (direct to backend, CORS handled by backend maxAge):
#   VITE_API_BASE_URL=http://localhost:3000
#
# After changing, restart `pnpm run dev`.
VITE_API_BASE_URL=/api

# ─── Playwright E2E (`npm run test:e2e`) ─────────────────────
# Copy this file to `.env` and fill these in. `playwright.config.ts` loads `.env` on startup.
# E2E_API_BASE_URL is passed to the dev server as VITE_API_BASE_URL so the browser can call the API.
# Use a user that exists in your DB (same as manual login). Needs permissions used by tests
# (e.g. employees.read, employees.create for employee-flow.spec.ts).
#
# Example:
#   E2E_API_BASE_URL=http://localhost:3000
#   E2E_LOGIN_EMAIL=admin@careadmin.local
#   E2E_LOGIN_PASSWORD=Admin@12345
E2E_API_BASE_URL=
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=

# ─── Figma icon export (`pnpm run fetch:figma-icons`) ───────
# Copy to `.env.local` only. Get token: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=
